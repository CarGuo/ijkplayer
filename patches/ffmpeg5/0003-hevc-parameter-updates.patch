+/* Read only the identifier, not the complete parameter set. Even with all
+ * six sublayer profiles present, the SPS identifier fits in 128 RBSP bytes. */
+static int hevc_ps_id(const uint8_t *nal, int size, int type, int layer_id)
+{
+    uint8_t rbsp[128 + AV_INPUT_BUFFER_PADDING_SIZE] = { 0 };
+    GetBitContext gb;
+    int i, n = 0, zeros = 0, max_id, id;
+
+    for (i = 2; i < size && n < 128; i++) {
+        if (i >= 4 && nal[i] == 3 && !nal[i - 1] && !nal[i - 2])
+            continue;
+        rbsp[n++] = nal[i];
+    }
+    if (!n)
+        return AVERROR_INVALIDDATA;
+    init_get_bits8(&gb, rbsp, n);
+    if (type == HEVC_NAL_VPS)
+        return get_bits(&gb, 4);
+    if (type == HEVC_NAL_SPS) {
+        int sublayers, profile[7], level[7];
+        skip_bits(&gb, 4); // sps_video_parameter_set_id
+        sublayers = get_bits(&gb, 3);
+        /* In a multilayer SPS, 7 signals sps_ext_or_max_sub_layers_minus1.
+         * Such SPSs omit temporal nesting and profile_tier_level. */
+        if (!layer_id || sublayers != 7) {
+            if (sublayers > 6 || get_bits_left(&gb) < 97)
+                return AVERROR_INVALIDDATA;
+            skip_bits_long(&gb, 97); // temporal nesting + general PTL
+            if (sublayers) {
+                if (get_bits_left(&gb) < 16)
+                    return AVERROR_INVALIDDATA;
+                for (i = 0; i < sublayers; i++) {
+                    profile[i] = get_bits1(&gb);
+                    level[i]   = get_bits1(&gb);
+                }
+                skip_bits(&gb, 2 * (8 - sublayers));
+                for (i = 0; i < sublayers; i++) {
+                    int bits = 88 * profile[i] + 8 * level[i];
+                    if (get_bits_left(&gb) < bits)
+                        return AVERROR_INVALIDDATA;
+                    skip_bits_long(&gb, bits);
+                }
+            }
+        }
+    }
+    if (get_bits_left(&gb) <= 0)
+        return AVERROR_INVALIDDATA;
+    max_id = type == HEVC_NAL_SPS ? HEVC_MAX_SPS_COUNT : HEVC_MAX_PPS_COUNT;
+    while (get_bits_left(&gb) > 0 && !get_bits1(&gb)) {
+        if (++zeros > 6)
+            return AVERROR_INVALIDDATA;
+    }
+    if (get_bits_left(&gb) < zeros)
+        return AVERROR_INVALIDDATA;
+    id = (1 << zeros) - 1;
+    if (zeros)
+        id += get_bits(&gb, zeros);
+    return id < max_id ? id : AVERROR_INVALIDDATA;
+}
 
