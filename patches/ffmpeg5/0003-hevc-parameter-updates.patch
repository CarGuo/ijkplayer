+static int hevc_ps_update(HEVCParameterSet **head, const uint8_t *nal,
+                          int size, int type)
+{
+    HEVCParameterSet **slot = head, *ps;
+    AVBufferRef *buf;
+    int layer_id, id;
+
+    if (size < 2 || (nal[0] & 0x80) || !(nal[1] & 7) ||
+        ((nal[0] >> 1) & 0x3f) != type || size > INT_MAX - 4)
+        return AVERROR_INVALIDDATA;
+    layer_id = ((nal[0] & 1) << 5) | (nal[1] >> 3);
+    id = hevc_ps_id(nal, size, type, layer_id);
+    if (id < 0)
+        return id;
+
+    /* VPS before SPS before PPS, preserving all IDs and layers. The optional
+     * final node contains all original SEI NALs in their original order. */
+    while (*slot && ((*slot)->type < type ||
+           ((*slot)->type == type && ((*slot)->layer_id < layer_id ||
+            ((*slot)->layer_id == layer_id &&
+             (*slot)->id < id)))))
+        slot = &(*slot)->next;
+    ps = *slot;
+    if (ps && ps->type == type && ps->layer_id == layer_id && ps->id == id &&
+        ps->nal->size == size + 4 && !memcmp(ps->nal->data + 4, nal, size))
+        return 0;
+    buf = av_buffer_alloc(size + 4);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    AV_WB32(buf->data, 1);
+    memcpy(buf->data + 4, nal, size);
+    if (!ps || ps->type != type || ps->layer_id != layer_id || ps->id != id) {
+        ps = av_mallocz(sizeof(*ps));
+        if (!ps) {
+            av_buffer_unref(&buf);
+            return AVERROR(ENOMEM);
         }
+        ps->type     = type;
+        ps->layer_id = layer_id;
+        ps->id       = id;
+        ps->next     = *slot;
+        *slot        = ps;
+    }
+    av_buffer_unref(&ps->nal);
+    ps->nal = buf;
+    return 0;
+}
 
