+static void hevc_mp4toannexb_flush(AVBSFContext *ctx)
+{
+    HEVCBSFContext *s = ctx->priv_data;
+    if (s->ps != s->initial_ps)
+        hevc_ps_free(&s->ps);
+    s->ps = s->initial_ps;
+    s->length_size = s->initial_length_size;
+    s->extradata_parsed = !!s->initial_length_size;
+}
+
+static void hevc_mp4toannexb_close(AVBSFContext *ctx)
+{
+    HEVCBSFContext *s = ctx->priv_data;
+    hevc_mp4toannexb_flush(ctx);
+    hevc_ps_free(&s->initial_ps);
+    s->ps = NULL;
+}
